/**
 * Editorial build tool, never called by learner requests.
 * Usage: pnpm --filter @workspace/scripts exec tsx ../artifacts/api-server/tools/build-consent-pilot.mts [--audio-only]
 * Generated bytes are ignored by Git; durable delivery uses App Storage.
 */
import { readFile, writeFile, mkdir, access } from "node:fs/promises";
import { fileURLToPath } from "node:url";
import path from "node:path";
import { promisify } from "node:util";
import { execFile } from "node:child_process";
import { textToSpeech } from "@workspace/integrations-openai-ai-server/audio";
import { batchProcess } from "@workspace/integrations-openai-ai-server/batch";
import { objectStorageClient } from "../src/lib/app-storage-client";

const exec = promisify(execFile);
const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../..");
const dir = path.join(root, "generated-artifacts/adhya-pilot");
const script = JSON.parse(await readFile(path.join(root, "artifacts/api-server/src/data/consent-pilot-script.json"), "utf8"));
await mkdir(dir, { recursive: true });
async function exists(file: string) { try { await access(file); return true; } catch { return false; } }
async function probe(file: string) {
  const { stdout } = await exec("ffprobe", ["-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", file]);
  const duration = Number(stdout.trim());
  if (!Number.isFinite(duration) || duration <= 0) throw new Error(`Invalid audio duration: ${file}`);
  return duration;
}
const utterances = script.scenes.flatMap((scene: { lines: string[] }, i: number) => scene.lines.map((text, j) => ({ text, i, j })));
await batchProcess(utterances, async ({ text, i, j }: { text: string; i: number; j: number }) => {
  const file = path.join(dir, `voice-${i}-${j}.mp3`);
  if (await exists(file)) return;
  const audio = await textToSpeech(text, "nova", "mp3");
  if (audio.length < 1024) throw new Error(`Narration was empty: ${i}-${j}`);
  await writeFile(file, audio);
  console.info(`Narration ${i + 1}.${j + 1} prepared`);
}, { concurrency: 2, retries: 3 });
if (process.argv.includes("--audio-only")) process.exit(0);

const font = path.join(dir, "Lato-Bold.ttf");
if (!await exists(font)) throw new Error("Download the Lato font into the render directory before rendering.");
const wrap = (text: string, width: number) => {
  const lines: string[] = [];
  for (const word of text.split(/\s+/)) {
    if (!lines.length || lines[lines.length - 1]!.length + word.length + 1 > width) lines.push(word);
    else lines[lines.length - 1] += ` ${word}`;
  }
  return lines.join("\n");
};
const cues: { start: number; end: number; text: string }[] = [];
const chapters: { title: string; start: number; end: number }[] = [];
let clock = 0;
for (let i = 0; i < script.scenes.length; i++) {
  const scene = script.scenes[i];
  const start = clock;
  const audioParts: string[] = [];
  for (let j = 0; j < scene.lines.length; j++) {
    const source = path.join(dir, `voice-${i}-${j}.mp3`);
    const wav = path.join(dir, `voice-${i}-${j}.wav`);
    await exec("ffmpeg", ["-y", "-v", "error", "-i", source, "-af", "loudnorm=I=-16:TP=-1.5:LRA=11,apad=pad_dur=0.35", "-ar", "48000", "-ac", "2", wav]);
    const duration = await probe(wav);
    cues.push({ start: clock, end: clock + duration - 0.35, text: scene.lines[j] });
    clock += duration;
    audioParts.push(`file '${wav}'`);
  }
  // Round up to a full frame so all chapter and checkpoint boundaries are stable.
  const duration = Math.ceil((clock - start) * 24) / 24;
  clock = start + duration;
  chapters.push({ title: scene.title, start, end: clock });
  const audioList = path.join(dir, `audio-${i}.txt`);
  await writeFile(audioList, audioParts.join("\n"));
  const audio = path.join(dir, `scene-${i}.wav`);
  await exec("ffmpeg", ["-y", "-v", "error", "-f", "concat", "-safe", "0", "-i", audioList, "-c:a", "pcm_s16le", audio]);
  const filters: string[] = [];
  let textCount = 0;
  async function text(value: string, x: string | number, y: string | number, size: number, color: string, extra = "") {
    const file = path.join(dir, `scene-${i}-text-${textCount++}.txt`);
    await writeFile(file, value);
    filters.push(`drawtext=fontfile='${font}':textfile='${file}':expansion=none:fontsize=${size}:fontcolor=${color}:line_spacing=20:x='${x}':y=${y}${extra}`);
  }
  const footage = scene.visual === "mentor" ? "library-intro.mp4" : scene.visual === "fieldwork" || scene.visual === "conversation" ? "fieldwork-choice.mp4" : null;
  let inputArgs: string[];
  if (footage) {
    inputArgs = ["-stream_loop", "-1", "-i", path.join(dir, footage)];
    filters.push("scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080,setsar=1");
    if (scene.visual === "mentor") {
      filters.push("drawbox=x=0:y=0:w=900:h=1080:color=0x171f43@0.95:t=fill");
      await text(wrap(scene.heading, 22), 90, 260, 62, "0xfff8ed");
      for (const [k, point] of scene.points.entries()) await text(wrap(point, 30), 95, 520 + k * 105, 32, "0xf6d17b", `:enable='gte(t,${k + 1})'`);
    } else {
      filters.push("drawbox=x=0:y=0:w=1920:h=220:color=0x171f43@0.9:t=fill");
      await text(scene.heading, 90, 115, 54, "0xfff8ed");
    }
  } else {
    inputArgs = ["-f", "lavfi", "-i", `color=c=0x171f43:s=1920x1080:r=24:d=${duration}`];
    filters.push("drawbox=x=1200:y=0:w=720:h=1080:color=0x235b62@0.5:t=fill");
    await text(wrap(scene.heading, 30), 90, 230, 64, "0xfff8ed");
    for (const [k, point] of scene.points.entries()) {
      const top = 440 + k * 135;
      filters.push(`drawbox=x=90:y=${top - 12}:w='min(iw-180,1740)':h=110:color=0x2e4665@0.8:t=fill:enable='gte(t,${k * 0.8 + 0.6})'`);
      await text(`${k + 1}   ${wrap(point, 68)}`, "110+16*min(t,1)", top + 8, 38, "0xf7f0e4", `:enable='gte(t,${k * 0.8 + 0.6})'`);
    }
  }
  await text("ADHYAAYAAN  /  A LESSON WITH ADHYA", 90, 55, 24, "0xf6d17b");
  filters.push("drawbox=x=0:y=1000:w=1920:h=80:color=0x171f43@0.95:t=fill");
  await text("AI-GENERATED VISUALS + VOICE  /  FICTIONAL LEARNING SCENARIO", 90, 1024, 22, "0xffffff");
  filters.push(`drawbox=x=0:y=992:w=1920:h=8:color=0xffffff@0.15:t=fill`, `drawbox=x=0:y=992:w='iw':h=8:color=0xf6d17b@0.7:t=fill`);
  filters.push(`fade=t=in:d=0.3,fade=t=out:st=${Math.max(0, duration - 0.3)}:d=0.3`);
  const avatarArgs = scene.visual === "mentor" ? ["-loop", "1", "-i", path.join(root, "artifacts/api-server/assets/mentor-avatar.png")] : [];
  const composition = scene.visual === "mentor"
    ? `[0:v]${filters.join(",")}[base];[2:v]scale=-2:850,format=rgba[mentor];[base][mentor]overlay=x='1040+8*sin(t*0.7)':y='185+4*sin(t*1.1)':shortest=1[v]`
    : `[0:v]${filters.join(",")}[v]`;
  await exec("ffmpeg", ["-y", "-v", "error", ...inputArgs, "-i", audio, ...avatarArgs, "-filter_complex", composition, "-map", "[v]", "-map", "1:a:0",
    "-af", "apad", "-t", String(duration), "-r", "24", "-c:v", "libx264", "-preset", "fast", "-crf", "21", "-pix_fmt", "yuv420p",
    "-c:a", "aac", "-b:a", "160k", "-ar", "48000", "-ac", "2", "-movflags", "+faststart", path.join(dir, `scene-${i}.mp4`)],
  { timeout: 240000, maxBuffer: 2e6 });
  console.info(`Scene ${i + 1}/${script.scenes.length}: ${duration.toFixed(1)}s rendered`);
}
const concat = path.join(dir, "scenes.txt");
await writeFile(concat, script.scenes.map((_: unknown, i: number) => `file '${path.join(dir, `scene-${i}.mp4`)}'`).join("\n"));
const output = path.join(dir, "consent-pilot.mp4");
await exec("ffmpeg", ["-y", "-v", "error", "-f", "concat", "-safe", "0", "-i", concat, "-c", "copy", "-movflags", "+faststart", output]);
const ts = (seconds: number) => new Date(Math.round(seconds * 1000)).toISOString().slice(11, 23);
await writeFile(path.join(dir, "consent-pilot.vtt"), "WEBVTT\n\n" + cues.map((c, i) => `${i + 1}\n${ts(c.start)} --> ${ts(c.end)}\n${c.text}\n`).join("\n"));
await exec("ffmpeg", ["-y", "-v", "error", "-ss", "2", "-i", output, "-frames:v", "1", "-q:v", "2", path.join(dir, "consent-pilot.jpg")]);
await writeFile(path.join(dir, "timing.json"), JSON.stringify({ duration: clock, chapters }, null, 2));
const prefix = process.env.PRIVATE_OBJECT_DIR;
if (!prefix) throw new Error("App Storage is not configured.");
const [bucket, ...parts] = prefix.replace(/^\/+/, "").split("/");
for (const file of ["consent-pilot.mp4", "consent-pilot.vtt", "consent-pilot.jpg", "library-intro.mp4", "fieldwork-choice.mp4"]) {
  const name = [...parts, "lessons", script.version, file].join("/");
  await objectStorageClient.bucket(bucket!).upload(path.join(dir, file), { destination: name, metadata: { contentType: file.endsWith(".mp4") ? "video/mp4" : file.endsWith(".vtt") ? "text/vtt" : "image/jpeg" } });
  console.info(`Saved ${file} to durable lesson storage`);
}
console.info(`Pilot ready: ${clock.toFixed(2)} seconds, 1920×1080`);
